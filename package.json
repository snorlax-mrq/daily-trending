{
  "name": "daily-trending",
  "version": "1.0.0",
  "private": true,
  "description": "三個來源的每日快照：HuggingFace 模型熱度、GitHub 專案熱度、Artificial Analysis 模型評測",
  "type": "module",
  "scripts": {
    "collect": "bun run src/collect.ts",
    "build": "bun run build.ts",
    "fonts": "bun run src/subset-fonts.ts",
    "publish": "bun run src/deploy.ts",
    "all": "bun run src/collect.ts && bun run build.ts && bun run src/subset-fonts.ts",
    "import-hf": "bun run src/import-hf-history.ts",
    "notion": "bun run src/notion-payload.ts --all",
    "push-hf": "cd .. && python3 scripts/notion_push.py --push --project hf --payload data/digest_out/payload_trending_hf_$(date +%F).json",
    "push-gh": "cd .. && python3 scripts/notion_push.py --push --project gh --payload data/digest_out/payload_trending_gh_$(date +%F).json",
    "push-aa": "cd .. && python3 scripts/notion_push.py --push --project aa --payload data/digest_out/payload_trending_aa_$(date +%F).json"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
